    Main_Entrance_Canopy_West,  !- Name
    ,                        !- Transmittance Schedule Name
    4,                       !- Number of Vertices
    0.0,                     !- Vertex 1 X-coordinate {m}
    0.0,                     !- Vertex 1 Y-coordinate {m}
    3.048,                   !- Vertex 1 Z-coordinate {m}
    0.0,                     !- Vertex 2 X-coordinate {m}
    -12.8016,                !- Vertex 2 Y-coordinate {m}
    3.048,                   !- Vertex 2 Z-coordinate {m}
    -3.658,                  !- Vertex 3 X-coordinate {m}
